### Accounts & Authentication Endpoints

@base_url = http://localhost:8000/api
@email = test@example.com
@password = password123
@owner_email = owner2@luxotel.com
@owner_password = password1234
@admin_email = admin@luxotel.com
@admin_password = adminpassword


# @name register
POST {{base_url}}/auth/register/
Content-Type: application/json

{   
    "email": "{{email}}",
    "name": "test user",
    "password": "{{password}}",
    "role": "user"
}   

###

# @name login
POST {{base_url}}/auth/login/
Content-Type: application/json

{
    "email": "{{email}}",
    "password": "{{password}}"
}

###

@access_token = {{login.response.body.token}}
@refresh_token = {{login.response.body.refresh}}

# @name get_me
GET {{base_url}}/auth/me/
Authorization: Bearer {{access_token}}

###

# @name update_profile
PATCH {{base_url}}/auth/profile/
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
    "phone": "987654321",
    "address": "Nouakchott, Mauritania"
}

###

# @name refresh_token_call
POST {{base_url}}/auth/refresh/
Content-Type: application/json

{
    "refresh": "{{refresh_token}}"
}

###

### Communication Endpoints

# @name list_notifications
GET {{base_url}}/notifications/
Authorization: Bearer {{access_token}}

###

# @name list_conversations
GET {{base_url}}/conversations/
Authorization: Bearer {{access_token}}

###

# @name create_conversation
POST {{base_url}}/conversations/
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
    "participants_ids": [],
    "hotel_id": null
}

###

# @name list_messages
GET {{base_url}}/messages/
Authorization: Bearer {{access_token}}

###

### Admin Endpoints (Requires Staff/Admin)

# @name login_admin
POST {{base_url}}/auth/login/
Content-Type: application/json

{
    "email": "{{admin_email}}",
    "password": "{{admin_password}}"
}

###

# @name register_owner
POST {{base_url}}/auth/register/
Content-Type: application/json

{   
    "email": "owner2@luxotel.com",
    "name": "Hotel Owner2",
    "password": "password1234",
    "role": "owner"
}

###

# @name login_owner
POST {{base_url}}/auth/login/
Content-Type: application/json

{
    "email": "{{owner_email}}",
    "password": "{{owner_password}}"
}

###

@owner_access_token = {{login_owner.response.body.token}}

# @name list_my_hotels
GET {{base_url}}/hotels/?mine=true
Authorization: Bearer {{owner_access_token}}

###

# @name create_hotel_as_owner
POST {{base_url}}/hotels/
Authorization: Bearer {{owner_access_token}}
Content-Type: application/json

{
    "name": "Owner's Boutique Hotel",
    "description": "A cozy hotel managed directly by its owner.",
    "location": "Nouadhibou",
    "price_per_night": 3500,
    "amenities": ["Wifi", "Breakfast", "Parking"]
}

###

@admin_token = {{login_admin.response.body.token}}

# @name list_invitations
GET {{base_url}}/invitations/
Authorization: Bearer {{admin_token}}


###

# @name create_invitation
POST {{base_url}}/invitations/
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
    "email": "new_owner@example.com",
    "role": "owner",
    "expires_at": "2026-12-31T23:59:59Z"
}

###

# @name logout
POST {{base_url}}/auth/logout/
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
    "refresh": "{{refresh_token}}"
}

### Hotel App Endpoints

# @name list_hotels
GET {{base_url}}/hotels/

###

# @name create_hotel
POST {{base_url}}/hotels/
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
    "name": "Luxotel Nouakchott",
    "description": "The finest luxury hotel in the capital.",
    "location": "Nouakchott",
    "price_per_night": 5000,
    "amenities": ["Spa", "Pool", "Gym"]
}

###

@hotel_id = {{create_hotel.response.body.id}}

# @name list_rooms
GET {{base_url}}/hotels/{{hotel_id}}/rooms/

###

# @name create_room
POST {{base_url}}/hotels/{{hotel_id}}/rooms/
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
    "type": "Deluxe Suite",
    "price": 7500,
    "capacity": 2,
    "amenities": ["Sea View", "King Bed"]
}

###

@room_id = {{create_room.response.body.id}}

# @name validate_promo
POST {{base_url}}/promotions/validate/
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
    "code": "SUMMER2026",
    "amount": 7500
}

###

@promotion_id = {{validate_promo.response.body.promotion_id}}

# @name create_booking
POST {{base_url}}/bookings/
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
    "room": "{{room_id}}",
    "check_in": "2026-06-01",
    "check_out": "2026-06-05",
    "promotion": "{{promotion_id}}"
}

###

@booking_id = {{create_booking.response.body.id}}

# @name get_booking
GET {{base_url}}/bookings/{{booking_id}}/
Authorization: Bearer {{access_token}}

###

# @name cancel_booking
PATCH {{base_url}}/bookings/{{booking_id}}/cancel/
Authorization: Bearer {{access_token}}

###

# @name list_reviews
GET {{base_url}}/hotels/{{hotel_id}}/reviews/

###

# @name create_promotion
POST {{base_url}}/promotions/
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
    "code": "SAVE20",
    "title": "Save 20 on your first stay",
    "discount_type": "PERCENTAGE",
    "discount_value": 20,
    "valid_from": "2026-01-01T00:00:00Z",
    "valid_until": "2026-12-31T23:59:59Z",
    "min_purchase": 1000,
    "active": true
}

###

# @name list_transactions
GET {{base_url}}/transactions/
Authorization: Bearer {{access_token}}

###

# @name list_pricing_rules
GET {{base_url}}/pricing-rules/
Authorization: Bearer {{admin_token}}



###

